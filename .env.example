# Copy to .env (gitignored). Dev values only.
OLLAMA_URL=http://ollama:11434          # or http://<dev-gpu-server>:11434
KEYCLOAK_ISSUER=http://localhost:8180/realms/insighthub
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio12345
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-change-me
AI_CALLER_CLIENT_SECRET=dev-only-change-me

# AI service, when run on the host (uv run ...). The compose ai-api/ai-worker set their own values.
DATABASE_URL=postgresql://ai:ai@localhost:5433/vectors   # vector DB from ai-service/compose.ai.yaml
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000

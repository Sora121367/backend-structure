{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(cd ai-service && uv run *)",
      "Bash(uv run *)",
      "Bash(npx @redocly/cli *)"
    ],
    "ask": [
      "Edit(/contracts/**)",
      "Edit(/docs/**)",
      "Edit(/CLAUDE.md)",
      "Edit(/**/CLAUDE.md)",
      "Edit(/modules/app/src/main/resources/db/migration/**)",
      "Edit(/ai-service/migrations/**)",
      "Edit(/modules/common/**)",
      "Edit(/settings.gradle.kts)",
      "Edit(/build.gradle.kts)",
      "Edit(/gradle/**)",
      "Edit(/keycloak/realm-export.json)",
      "Edit(/.github/**)",
      "Edit(/**/compose*.yaml)",
      "Bash(git push *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/**/.env)",
      "Read(/**/*.pem)",
      "Read(/**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" }
        ]
      }
    ]
  }
}
